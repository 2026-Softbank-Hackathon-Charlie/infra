{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "existingSecrets"
  ],
  "properties": {
    "existingSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "collector",
        "clickhouse",
        "mongodb",
        "sources",
        "otlpTLS"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "collector": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "clickhouse": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "mongodb": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "sources": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "otlpTLS": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        }
      }
    },
    "hyperdx": {
      "type": "object",
      "properties": {
        "secrets": {
          "not": {}
        },
        "queryTrust": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "configMap": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "additionalIngestTokenKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9._-]+$",
        "minLength": 1
      }
    },
    "privateIngest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "privateSubnets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^subnet-[a-f0-9]+$"
          }
        },
        "sourceRanges": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^10\\.40\\.[0-9]+\\.0/[0-9]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "privateSubnets",
              "sourceRanges"
            ],
            "properties": {
              "privateSubnets": {
                "minItems": 2,
                "uniqueItems": true
              },
              "sourceRanges": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}

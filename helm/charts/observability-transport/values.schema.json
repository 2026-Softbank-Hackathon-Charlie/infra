{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "role",
    "proxyNamespace",
    "tailnetDomain",
    "centralHostname",
    "queryHostname"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "role": {
      "enum": [
        "management",
        "gke",
        "onprem"
      ]
    },
    "proxyNamespace": {
      "const": "hopcharlie-db-network"
    },
    "tailnetDomain": {
      "type": "string",
      "pattern": "^tail[a-z0-9]+\\.ts\\.net$"
    },
    "centralHostname": {
      "const": "hop-observability-central"
    },
    "queryHostname": {
      "enum": ["hop-observability-gke-query", "hop-observability-onprem-query"]
    },
    "peerEnvironment": {
      "enum": ["gke", "onprem"]
    },
    "centralIngressEnabled": {
      "type": "boolean"
    }
  }
}

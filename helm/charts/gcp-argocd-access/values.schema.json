{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "googleServiceAccountEmail",
    "managedNamespaces",
    "createNamespaces"
  ],
  "additionalProperties": false,
  "properties": {
    "googleServiceAccountEmail": {
      "type": "string",
      "pattern": "^[a-z][-a-z0-9]*@[-a-z0-9]+\\.iam\\.gserviceaccount\\.com$"
    },
    "managedNamespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
        "not": {
          "enum": [
            "kube-system",
            "argocd"
          ]
        }
      }
    },
    "createNamespaces": {
      "type": "boolean"
    },
    "dynamicApps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "grantAccess",
        "protectedNamespaces"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "grantAccess": {
          "type": "boolean"
        },
        "protectedNamespaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "openExistingPolicy",
        "grantAccess"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "openExistingPolicy": {
          "type": "boolean"
        },
        "grantAccess": {
          "type": "boolean"
        },
        "appResourcesEnabled": {
          "type": "boolean"
        },
        "appResourcesGranted": {
          "type": "boolean"
        },
        "appCABundle": {
          "type": "string"
        }
      }
    }
  }
}

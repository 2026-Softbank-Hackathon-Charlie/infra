aws_account_id = "000000000000"
aws_region = "ap-northeast-2"
project = "charlie"
environment = "dev"
github_oidc_subject_prefix = "repo:YOUR_OWNER/charlie-infra"
# 기존 계정: provider 조회 후 해당 ARN 지정. provider가 없는 새 계정만 빈 문자열.
github_oidc_provider_arn = "arn:aws:iam::000000000000:oidc-provider/token.actions.githubusercontent.com"
management_cluster_name = "charlie-dev-management"
workload_cluster_name = "charlie-dev-workload"

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "targetTime", "imageName", "backup", "resources", "backupResources"],
  "properties": {
    "runId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,19}$"},
    "targetTime": {"type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "imageName": {"type": "string", "pattern": "^ghcr\\.io/cloudnative-pg/postgresql:[^@ ]+@sha256:[a-f0-9]{64}$"},
    "backup": {
      "type": "object", "additionalProperties": false,
      "required": ["bucketName", "region"],
      "properties": {
        "bucketName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"},
        "region": {"const": "ap-northeast-2"}
      }
    },
    "resources": {"$ref": "#/definitions/resources"},
    "backupResources": {"$ref": "#/definitions/resources"}
  },
  "definitions": {
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {"requests": {"$ref": "#/definitions/quantities"}, "limits": {"$ref": "#/definitions/quantities"}}
    },
    "quantities": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "string", "pattern": "^[0-9]+([.][0-9]+)?m?$"},
        "memory": {"type": "string", "pattern": "^[0-9]+([.][0-9]+)?(Ki|Mi|Gi)$"}
      }
    }
  }
}
